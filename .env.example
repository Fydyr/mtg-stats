# Nom du conteneur / routeur Traefik
NAME=mtg-stats
PREFIX_NAME=mtg-stats
DOMAIN=mtg-stats.aeroliths.fr

# PostgreSQL
POSTGRES_USER=mtgstats
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mtgstats
# En prod (docker compose) l'hôte est "postgres" ; en dev local c'est "localhost"
DATABASE_URL=postgresql://mtgstats:change-me@postgres:5432/mtgstats?schema=public

# Page /admin (saisie des prix)
NUXT_ADMIN_PASSWORD=change-me
# Chaîne aléatoire longue (ex: openssl rand -hex 32)
NUXT_SESSION_SECRET=change-me-with-a-long-random-string

# Token pour webhook d'automatisation externe (optionnel, ex: cron ou scraper externe)
NUXT_SYNC_SECRET=change-me-with-a-long-random-secret

